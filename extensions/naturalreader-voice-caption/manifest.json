{
  "manifest_version": 3,
  "name": "FreeTTS Voice Automation",
  "version": "1.1.0",
  "description": "Dictates speech into FreeTTS and automatically generates and plays only new words after a pause.",
  "permissions": [],
  "host_permissions": [
    "https://freetts.com/*",
    "https://*.freetts.com/*",
    "https://freetts.org/*",
    "https://*.freetts.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://freetts.com/*",
        "https://*.freetts.com/*",
        "https://freetts.org/*",
        "https://*.freetts.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
