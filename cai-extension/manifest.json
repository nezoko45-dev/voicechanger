{
  "manifest_version": 3,
  "name": "Character.AI Voice Automation",
  "version": "1.0.0",
  "description": "Hands-free dictation and voice playback monitoring for Character.AI.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://character.ai/*", "https://*.character.ai/*"],
  "action": { "default_popup": "popup.html", "default_title": "CAI Voice Automation" },
  "content_scripts": [{
    "matches": ["https://character.ai/*", "https://*.character.ai/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}