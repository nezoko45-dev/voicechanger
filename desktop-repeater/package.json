{
  "name": "kokoro-webgpu-repeater",
  "version": "1.0.0",
  "private": true,
  "description": "Local Whisper + Kokoro voice repeater desktop app",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "dist:win": "vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.daki.kokorovoicerepeater",
    "productName": "Kokoro Voice Repeater",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}