<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ChilloutVRSizeMod</AssemblyName>
    <RootNamespace>ChilloutVRSizeMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader 0.7.3 provides a .NET Framework 4.7.2-compatible asset. -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
