<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ChilloutVRSizeMod</AssemblyName>
    <RootNamespace>ChilloutVRSizeMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" />
    <!-- UnityEngine.CoreModule 2022.3.58f1 is not published as a matching NuGet package.
         This compile-time reference is kept at the known working package version; the DLL is
         loaded by ChilloutVR's own Unity 2022.3.58f1 runtime. -->
    <PackageReference Include="UnityEngine.CoreModule" Version="2020.3.1" PrivateAssets="all" />
  </ItemGroup>
</Project>
