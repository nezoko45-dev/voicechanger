<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ChilloutVRSizeMod</AssemblyName>
    <RootNamespace>ChilloutVRSizeMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader package is kept at the latest public package version so CI restore works. -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" />
    <!-- ChilloutVR uses Unity 2022.3.58f1. This package is only a compile-time UnityEngine reference. -->
    <PackageReference Include="UnityEngine.CoreModule" Version="2022.3.58" PrivateAssets="all" />
  </ItemGroup>
</Project>
