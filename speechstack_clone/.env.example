PORT=8787

# Streaming STT provider. SpeechStack recipes commonly use Deepgram.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# Your actual custom-WAV-cloning TTS service.
# It must accept POST /clone and POST /speak, or adapt the two functions in server.mjs.
TTS_CLONE_URL=
TTS_SPEAK_URL=
TTS_API_KEY=

# Optional local reference voice path.
REFERENCE_WAV=./voices/reference.wav
