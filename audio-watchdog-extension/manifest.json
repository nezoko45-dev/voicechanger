{
  "manifest_version": 3,
  "name": "Audio Watchdog — Auto Restart",
  "version": "1.1.0",
  "description": "Restarts the dictation page by clicking Stop then Start when read-aloud appears stuck.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Audio Watchdog",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nezoko45-dev.github.io/voicechanger/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
