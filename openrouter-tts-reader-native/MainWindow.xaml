<Window x:Class="OpenRouterTtsReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge TTS Reader" Height="800" Width="1000" MinHeight="700" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Edge TTS Reader" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Native Windows app • Edge neural voices routed through NAudio • Selectable audio output" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="API key (cloud providers only)" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ApiKeyBox" Padding="9" FontSize="14"/>
            <TextBlock Text="The key stays in memory for this session and is sent directly to Groq. It is not saved to disk." Foreground="Gray" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Speech model" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="ModelBox" Padding="7" SelectionChanged="ModelBox_SelectionChanged">
                    <ComboBoxItem Content="Groq Orpheus English TTS" Tag="canopylabs/orpheus-v1-english" IsSelected="True"/>
                    <ComboBoxItem Content="Mistral Voxtral Mini TTS" Tag="mistralai/voxtral-mini-tts-2603"/>
                    <ComboBoxItem Content="Microsoft MAI Voice 2" Tag="microsoft/mai-voice-2"/>
                    <ComboBoxItem Content="Local Windows Voice (Free)" Tag="local-windows"/>
                    <ComboBoxItem Content="Microsoft Edge Voices (Free)" Tag="edge-browser"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Voice" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="VoiceBox" Padding="7"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Audio output device" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="OutputDeviceBox" Padding="7"/>
            </StackPanel>
        </Grid>
        <WrapPanel Grid.Row="3" Margin="0,0,0,10" VerticalAlignment="Center">
            <Button x:Name="StartDictationButton" Content="Windows dictation" Padding="12,8" Margin="0,0,8,8" Click="StartDictation_Click"/>
            <Button x:Name="StartBrowserDictationButton" Content="Edge microphone dictation" Padding="12,8" Margin="0,0,8,8" Click="StartBrowserDictation_Click"/>
            <Button x:Name="StopDictationButton" Content="Stop dictation" Padding="12,8" Margin="0,0,8,8" IsEnabled="False" Click="StopDictation_Click"/>
            <CheckBox x:Name="AutoReadCheckBox" Content="Automatically read finished phrases" IsChecked="True" VerticalAlignment="Center" Margin="4,0,16,8"/>
            <CheckBox x:Name="ClearAfterReadCheckBox" Content="Clear text after playback" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,8"/>
        </WrapPanel>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Dictation / text to read aloud" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox Grid.Row="1" x:Name="TextBoxInput" FontSize="15" Padding="10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SpellCheck.IsEnabled="True"/>
        </Grid>
        <WrapPanel Grid.Row="5" Margin="0,0,0,10">
            <Button x:Name="SpeakButton" Content="Generate &amp; Read Aloud" Padding="14,9" Margin="0,0,8,0" Click="Speak_Click"/>
            <Button x:Name="StopAudioButton" Content="Stop audio" Padding="14,9" Margin="0,0,8,0" IsEnabled="False" Click="StopAudio_Click"/>
            <Button Content="Clear text" Padding="14,9" Click="Clear_Click"/>
        </WrapPanel>
        <Border Grid.Row="6" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" CornerRadius="8" Padding="10">
            <TextBlock x:Name="StatusText" Text="Ready. Select Microsoft Edge Voices (Free), choose a voice, then start dictation or type text." TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>