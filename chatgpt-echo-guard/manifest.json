{
  "manifest_version": 3,
  "name": "ChatGPT Echo Guard",
  "version": "1.5.0",
  "description": "Detect local echo mismatches and send a single recovery prompt with cooldown.",
  "permissions": [
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Echo Guard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
