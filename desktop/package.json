{
  "name": "voicechanger-desktop",
  "version": "2.3.1",
  "private": true,
  "description": "Windows desktop STT/TTS VoiceChanger with Deepgram STT, Pocket TTS voice cloning, and Magic Mic virtual audio",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.nezoko45.voicechanger",
    "productName": "VoiceChanger Desktop",
    "artifactName": "VoiceChanger-Desktop-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "deepgram-proxy.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "driver",
        "to": "driver"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  }
}
