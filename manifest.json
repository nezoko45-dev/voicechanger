{
  "manifest_version": 3,
  "name": "Inworld AI Voice Dictation",
  "version": "1.3.0",
  "description": "Dictation side panel for Inworld AI TTS with background-tab auto-generation.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://inworld.ai/*",
    "https://*.inworld.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://inworld.ai/*",
        "https://*.inworld.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Inworld AI Voice Dictation",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
