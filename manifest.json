{
  "manifest_version": 3,
  "name": "Zalt Voice Dictation for VRChat",
  "version": "2.3.2",
  "minimum_chrome_version": "116",
  "description": "One-button dictation that fills Zalt Text to Speech and clicks Generate Speech for VRChat.",
  "permissions": ["storage", "sidePanel", "tabs", "offscreen"],
  "host_permissions": ["https://zalt.me/*"],
  "content_scripts": [{
    "matches": ["https://zalt.me/tools/text-to-speech*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_title": "Zalt VRChat Voice", "default_popup": "popup.html"},
  "side_panel": {"default_path": "dashboard.html"},
  "background": {"service_worker": "service-worker.js"}
}