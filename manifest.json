{
  "manifest_version": 3,
  "name": "Fish Audio Call Again Clicker",
  "version": "3.1.0",
  "minimum_chrome_version": "116",
  "description": "Automatically click Fish Audio's Call again button when it becomes available.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://fish.audio/*",
    "https://*.fish.audio/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fish.audio/*",
        "https://*.fish.audio/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fish Audio Call Again Clicker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
