{
  "manifest_version": 3,
  "name": "Inworld AI Voice Dictation",
  "version": "1.2.0",
  "description": "Dictate into Inworld AI's text-to-speech box and automatically generate speech after a pause.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://inworld.ai/*",
    "https://platform.inworld.ai/*",
    "https://studio.inworld.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://inworld.ai/*",
        "https://platform.inworld.ai/*",
        "https://studio.inworld.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Inworld AI Voice Dictation",
    "default_popup": "popup.html"
  }
}