{
  "manifest_version": 3,
  "name": "TTSLab Fast Dictation",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "description": "Live background dictation for TTSLab; shows words as you speak and auto-submits after a pause.",
  "permissions": ["tabs", "offscreen"],
  "host_permissions": ["https://ttslab.dev/*", "https://*.ttslab.dev/*"],
  "content_scripts": [{
    "matches": ["https://ttslab.dev/*", "https://*.ttslab.dev/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "TTSLab Fast Dictation",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "service-worker.js" }
}
