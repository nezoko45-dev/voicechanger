{
  "manifest_version": 3,
  "name": "Zalt Voice Dictation for VRChat",
  "version": "2.3.3",
  "minimum_chrome_version": "116",
  "description": "Automatic speech dictation, Zalt speech generation, and generated-audio playback for VRChat.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "https://zalt.me/*",
    "https://elevenlabs.io/*",
    "https://*.elevenlabs.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://zalt.me/tools/text-to-speech*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://elevenlabs.io/*",
        "https://*.elevenlabs.io/*"
      ],
      "js": [
        "elevenlabs-autoclicker.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Zalt VRChat Voice",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
