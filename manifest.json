{
  "manifest_version": 3,
  "name": "Inworld Voice Dictation for VRChat",
  "version": "2.0.0",
  "minimum_chrome_version": "116",
  "description": "One-button background dictation with Inworld AI text-to-speech playback for VRChat.",
  "permissions": ["storage", "sidePanel", "tabs", "offscreen"],
  "host_permissions": ["https://api.inworld.ai/*", "https://platform.inworld.ai/*"],
  "action": {"default_title": "Inworld VRChat Voice", "default_popup": "popup.html"},
  "side_panel": {"default_path": "dashboard.html"},
  "background": {"service_worker": "service-worker.js"}
}