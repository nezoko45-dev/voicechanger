{
  "manifest_version": 3,
  "name": "ElevenLabs Voice Dictation for VRChat",
  "version": "1.4.0",
  "description": "Speech dictation side panel that queues phrases for ElevenLabs Text to Speech while you play VRChat.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://elevenlabs.io/*",
    "https://*.elevenlabs.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://elevenlabs.io/*",
        "https://*.elevenlabs.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ElevenLabs Voice Dictation",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}