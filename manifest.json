{
  "manifest_version": 3,
  "name": "ChatGPT Voice Dictation",
  "version": "1.1.0",
  "description": "Continuously dictate into ChatGPT, send after a pause, and automatically start Read Aloud for the reply.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChatGPT Voice Dictation",
    "default_popup": "popup.html"
  }
}