{
  "manifest_version": 3,
  "name": "ElevenLabs Voice Dictation for VRChat",
  "version": "1.8.0",
  "minimum_chrome_version": "116",
  "description": "Background speech dictation with a full-size dashboard for ElevenLabs Text to Speech and VRChat.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://elevenlabs.io/*",
    "https://*.elevenlabs.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://elevenlabs.io/*",
        "https://*.elevenlabs.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VRChat Voice Dictation",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}