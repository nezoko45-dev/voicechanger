{
  "manifest_version": 3,
  "name": "Fish Audio Call Again",
  "version": "1.0.1",
  "description": "Automatically click Fish Audio\u0027s visible Call again button.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://fish.audio/*", "https://*.fish.audio/*"],
  "action": {"default_title": "Fish Audio Call Again", "default_popup": "extension/popup.html"},
  "content_scripts": [{"matches": ["https://fish.audio/*", "https://*.fish.audio/*"], "js": ["extension/content.js"], "run_at": "document_idle"}]
}