{
  "manifest_version": 3,
  "name": "Fast Dictation for TTSLab + Fish Audio",
  "version": "3.0.0",
  "minimum_chrome_version": "116",
  "description": "Live background dictation for TTSLab and Fish Audio; generates speech after a pause.",
  "permissions": ["tabs", "offscreen", "storage"],
  "host_permissions": ["https://ttslab.dev/*", "https://*.ttslab.dev/*", "https://fish.audio/*", "https://*.fish.audio/*", "http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "content_scripts": [{
    "matches": ["https://ttslab.dev/*", "https://*.ttslab.dev/*", "https://fish.audio/*", "https://*.fish.audio/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Fast Dictation for TTSLab + Fish Audio",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "service-worker.js" }
}
