{
  "manifest_version": 3,
  "name": "ChatGPT Voice Dictator",
  "version": "1.0.0",
  "description": "Continuous microphone dictation into ChatGPT, auto-send, and Read Aloud loop.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voice Dictator"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}