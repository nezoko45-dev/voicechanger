{
  "manifest_version": 3,
  "name": "Uberduck Voice Dictation",
  "version": "1.0.0",
  "description": "Dictate into Uberduck's text-to-speech box and optionally generate speech when you finish talking.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://uberduck.ai/*",
    "https://www.uberduck.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://uberduck.ai/*",
        "https://www.uberduck.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Uberduck Voice Dictation",
    "default_popup": "popup.html"
  }
}