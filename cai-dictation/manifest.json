{
  "manifest_version": 3,
  "name": "Character.AI Voice Dictation",
  "version": "1.2.0",
  "description": "Dictate into Character.AI and automatically restart Chrome speech recognition after timeouts.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://character.ai/*",
        "https://*.character.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
