{
  "manifest_version": 3,
  "name": "Character.AI Voice Dictation",
  "version": "1.1.0",
  "description": "Local Whisper dictation using the Windows default microphone.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://character.ai/*",
        "https://*.character.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
