{
  "manifest_version": 3,
  "name": "Talkie + Character.AI Voice Dictation",
  "version": "1.4.1",
  "description": "Dictate into Talkie or Character.AI, automatically restart speech recognition, and play new replies when supported.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://character.ai/*",
        "https://*.character.ai/*",
        "https://talkie-ai.com/*",
        "https://www.talkie-ai.com/*",
        "https://*.talkie-ai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
