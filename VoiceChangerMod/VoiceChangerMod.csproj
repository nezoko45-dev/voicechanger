<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VoiceChangerMod</AssemblyName>
    <RootNamespace>VoiceChangerMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\BrowserVoiceChanger\index.html" Link="BrowserVoiceChanger\index.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrowserVoiceChanger\app.js" Link="BrowserVoiceChanger\app.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\BrowserVoiceChanger\style.css" Link="BrowserVoiceChanger\style.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="audio_bridge.py" Link="audio_bridge.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="requirements.txt" Link="requirements.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
