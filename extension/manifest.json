{
  "manifest_version": 3,
  "name": "Fish Audio Call Again",
  "version": "1.0.2",
  "description": "Automatically click Fish Audio's visible Call again button.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://fish.audio/*", "https://*.fish.audio/*"],
  "action": {
    "default_title": "Fish Audio Call Again",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://fish.audio/*", "https://*.fish.audio/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}