{
  "manifest_version": 3,
  "name": "Character.AI Voice SVG Bridge",
  "version": "1.0.0",
  "description": "Targets Character.AI's actual Voice toolbar SVG, rather than its unreliable accessible name.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://character.ai/*", "https://*.character.ai/*"],
  "action": {"default_popup": "popup.html", "default_title": "c.ai Voice SVG Toggle"},
  "content_scripts": [{
    "matches": ["https://character.ai/*", "https://*.character.ai/*"],
    "js": ["voice-button-content.js"],
    "run_at": "document_idle"
  }]
}