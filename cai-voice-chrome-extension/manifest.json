{
  "manifest_version": 3,
  "name": "CAI Voice Loop",
  "version": "1.0.0",
  "description": "Dictate to Character.AI and play the newest reply automatically.",
  "permissions": ["storage"],
  "host_permissions": ["https://character.ai/*", "https://*.character.ai/*"],
  "content_scripts": [{
    "matches": ["https://character.ai/*", "https://*.character.ai/*"],
    "js": ["content.js"],
    "css": ["overlay.css"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "CAI Voice Loop" }
}